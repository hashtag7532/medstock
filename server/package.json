{
  "name": "medstock-server",
  "version": "0.1.0",
  "private": true,
  "description": "MedStock API: per-user storage and sync, authenticated with Firebase phone OTP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "emulator": "firebase emulators:start --only auth --project demo-medstock",
    "test": "node --env-file-if-exists=.env --test test/"
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "firebase-tools": "^15.34.0"
  }
}
