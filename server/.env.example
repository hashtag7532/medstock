# Copy to .env and adjust.
PORT=8080
DATABASE_URL=postgres://parthdodia@localhost:5432/medstock

# Local development: tokens come from the Firebase Auth emulator (npm run emulator).
FIREBASE_PROJECT_ID=demo-medstock
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Real Firebase: set your project ID and remove FIREBASE_AUTH_EMULATOR_HOST.
# FIREBASE_PROJECT_ID=your-firebase-project-id
